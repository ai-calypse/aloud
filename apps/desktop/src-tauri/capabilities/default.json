{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window and the recording overlay",
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "autostart:default"
  ]
}
