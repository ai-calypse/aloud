{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window, the recording overlay and the listening bar",
  "windows": [
    "main",
    "overlay",
    "listen"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "core:window:allow-set-size",
    "autostart:default",
    "core:window:allow-start-dragging"
  ]
}
