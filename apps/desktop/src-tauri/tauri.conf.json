{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aloud",
  "version": "0.1.0",
  "identifier": "app.aloud.desktop",
  "build": {
    "beforeDevCommand": "cargo build -p aloud-hook-cli && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aloud",
        "width": 900,
        "height": 640,
        "visible": false,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 1000,
        "height": 720,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/Aloud/media/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "resources": [
      "resources/*",
      "resources/engine/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.aloud.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  }
}
