{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aloud",
  "version": "0.1.0",
  "identifier": "app.aloud.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aloud",
        "width": 900,
        "height": 640,
        "visible": false,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 320,
        "height": 96,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": false
      },
      {
        "label": "ask",
        "url": "ask.html",
        "title": "Ask",
        "width": 500,
        "height": 120,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "agent",
        "url": "agent.html",
        "title": "Agent",
        "width": 500,
        "height": 120,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.aloud.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  }
}
