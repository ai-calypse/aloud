# Forms post to /api/form (api/form.ts, emails you through ZeptoMail). These two only
# override that with another backend; leave blank normally.
VITE_WAITLIST_URL=
VITE_BUGS_URL=

# Server-side, set in Vercel (Settings > Environment Variables), never VITE_-prefixed:
#   ZEPTOMAIL_TOKEN  required. ZeptoMail > Agents > Send Mail token
#   ZEPTOMAIL_HOST   default https://api.zeptomail.com (.in / .eu for other data centers)
#   MAIL_FROM        default no-reply@speakos.app (verified ZeptoMail domain)
#   WAITLIST_TO      default hello@speakos.app
#   BUGS_TO          default bugs@speakos.app

# Analytics: leave any blank to turn it off. Nothing loads without its ID.
VITE_GA_ID=            # GA4 measurement id, like G-XXXXXXXXXX
VITE_CLARITY_ID=       # Microsoft Clarity project id
GSC_TOKEN=             # Google Search Console "HTML tag" verification content
SITE_URL=              # the live address, like https://speakos.app (used for sitemap, canonical, OG)
